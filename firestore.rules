rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may only touch their own documents: users/{uid}/data/{docId}
    // docId is "meta" or "log-<monthId>".
    match /users/{uid}/data/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && docId.matches('^(meta|log-[A-Za-z0-9_-]{1,40})$')
        && request.resource.data.keys().hasOnly(['ts', 'body'])
        && request.resource.data.ts is number
        && request.resource.data.body is map;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
