rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app: only the owner's account may read or write, and only their own documents:
    // users/{uid}/data/{docId}, where docId is "meta" or "log-<monthId>".
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'katiec1029@gmail.com';
    }
    match /users/{uid}/data/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && docId.matches('^(meta|log-[A-Za-z0-9_-]{1,40})$')
        && request.resource.data.keys().hasOnly(['ts', 'body'])
        && request.resource.data.ts is number
        && request.resource.data.body is map;
      allow delete: if isOwner(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
