{
  "name": "workout-tracker",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/*.test.js\"",
    "test:unit": "node --test tests/unit/*.test.js",
    "test": "npm run test:unit && npm run test:rules",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:emulator": "firebase emulators:exec --project demo-workout-tracker --only auth,firestore \"playwright test --project emulator\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.63.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.35.1"
  }
}
